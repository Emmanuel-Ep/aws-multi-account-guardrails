{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowCloudTrailCheckBucket",
      "Effect": "Allow",
      "Principal": { "Service": "cloudtrail.amazonaws.com" },
      "Action": "s3:GetBucketAcl",
      "Resource": "${bucket_arn}",
      "Condition": {
        "StringEquals": { "aws:SourceArn": "${trail_arn}" }
      }
    },
    {
      "Sid": "AllowCloudTrailWriteManagementAccount",
      "Effect": "Allow",
      "Principal": { "Service": "cloudtrail.amazonaws.com" },
      "Action": "s3:PutObject",
      "Resource": "${bucket_arn}/AWSLogs/${account_id}/*",
      "Condition": {
        "StringEquals": {
          "s3:x-amz-acl": "bucket-owner-full-control",
          "aws:SourceArn": "${trail_arn}"
        }
      }
    },
    {
      "Sid": "AllowCloudTrailWriteOrganization",
      "Effect": "Allow",
      "Principal": { "Service": "cloudtrail.amazonaws.com" },
      "Action": "s3:PutObject",
      "Resource": "${bucket_arn}/AWSLogs/${org_id}/*",
      "Condition": {
        "StringEquals": {
          "s3:x-amz-acl": "bucket-owner-full-control",
          "aws:SourceArn": "${trail_arn}"
        }
      }
    },
    {
      "Sid": "DenyDeletingLogs",
      "Effect": "Deny",
      "Principal": "*",
      "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": "${bucket_arn}/*"


    },

     {
      "Sid" : "DenyUnencryptedConnections",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": ["${bucket_arn}", "${bucket_arn}/*" ],
      "Condition": {
        "Bool": {"aws:SecureTransport": "false"}
      }

     }

  ]
}
      